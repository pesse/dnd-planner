# Konfiguration für die Prompt-Qualitäts-Evals (npm run eval).
# Kopieren nach ".env" und Werte eintragen — ".env" ist gitignored.

# QualityMinds API-Key (Pflicht, sonst werden die Evals übersprungen)
QM_API_KEY=

# vLLM-Modell-ID auf QualityMinds (Pflicht)
EVAL_MODEL=

# Welcher Prompt getestet wird (optional, Default "baseline"; siehe
# evals/prompts/featureEffects.ts → FEATURE_EFFECTS_PROMPTS). Es wird immer GENAU
# EIN Prompt ausgewertet; zum Vergleichen mehrmals mit anderem Wert laufen lassen.
# EVAL_PROMPT=baseline

# Titel + Beschreibung für den Report (optional). Der Titel landet im Ordnernamen
# (evals/reports/<timestamp>-<titel>/) und macht mehrere Läufe unterscheidbar.
# EVAL_TITLE=baseline
# EVAL_DESC=Ausgangsprompt aus der Produktion

# Anzahl Läufe pro Assertion (optional, Default 5; bei langsamen Modellen 2-3)
# EVAL_RUNS=5

# Mindest-Pass-Rate der Core-Assertions (optional, Default 0.9)
# EVAL_THRESHOLD=0.9

# Parallele Läufe je Step (optional, Default 4). 1 = sequenziell für saubere
# Einzel-Latenz. Nur die Runs eines Steps laufen parallel; Varianten/Steps sequenziell.
# EVAL_CONCURRENCY=4

# Per-Call-Timeout in ms (optional, Default 120000) — kappt hängende LLM-Requests
# EVAL_CALL_TIMEOUT_MS=120000

# Gesamt-Test-Timeout in ms (optional, Default 1800000 = 30 min)
# EVAL_TIMEOUT_MS=1800000
