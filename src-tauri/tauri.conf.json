{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DnD Planner",
  "version": "0.10.2",
  "identifier": "de.developer-sam.dnd-planner",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "DnD Planner",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY0NjFENTZCN0U2NEYxMQpSV1FSVCthM1ZoMUdEeUFUNFRCdWt6TU1aVXZsTUd6YUR1Y1pmV3JETWxGQ1ZEK2FsSk5IQ1Nkdgo=",
      "endpoints": [
        "https://github.com/pesse/dnd-planner/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
